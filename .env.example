# Production settings. Copy to .env and fill in. Never commit .env.
# For LAN/local testing, leave PUBLIC_ORIGIN and TRUST_PROXY empty and set PUBLISH_PORT=8080.

# Long random string; enables /api/admin/* moderation. Generate: openssl rand -hex 24
ADMIN_TOKEN=

# Caddy (or another reverse proxy) sits in front and sets X-Forwarded-For.
TRUST_PROXY=1

# The one origin allowed to post. threechords.dev and www.* redirect here.
PUBLIC_ORIGIN=https://3chords.dev

# Only reachable from the proxy on this host, never directly from the internet.
# (With TRUST_PROXY=1, a directly exposed port would let clients fake their IP.)
PUBLISH_PORT=127.0.0.1:8080

# Which published image to run: latest = newest release. Pin a tag (e.g. v1.2.0) to
# hold production still or roll back; deploy/update.sh then leaves it alone.
IMAGE_TAG=latest
