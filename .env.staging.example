# Staging settings (staging.3chords.dev). Copy to .env.staging and fill in. Never commit it.
# Runs next to production on the same host, from the same compose.yaml:
#   docker compose -p threechords-staging --env-file .env.staging up -d
# The project name (-p) gives staging its own database volume, so nothing here touches production.

# Tip of main, rebuilt by CI on every merge.
IMAGE_TAG=staging
CONTAINER_NAME=threechords-staging

# Use a different token from production. Generate: openssl rand -hex 24
ADMIN_TOKEN=

TRUST_PROXY=1
PUBLIC_ORIGIN=https://staging.3chords.dev

# Production has 8080; staging takes the next port, also proxy-only.
PUBLISH_PORT=127.0.0.1:8081
